+// 导航目标总线：四时集首页 → ModuleHub 的单向传参（页面跳转前写入，渲染只读）。
+// 作用：把"四个模块"折叠为同一个 branch-1 路由 'ModuleHub'，规避本 SDK 冷启动 Navigation
+//       首个 push 只对 PageMap 第 1 分支稳定的 bug（凡首次直推晚分支就会建空节点 → 白屏）。
+export let moduleTarget: string = 'dining';
+
+export function setModuleTarget(route: string): void {
+  moduleTarget = route;
+}
