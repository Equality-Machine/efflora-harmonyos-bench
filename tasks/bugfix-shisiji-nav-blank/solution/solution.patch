+// 全局导航栈单例：四时集全应用共用一个 NavPathStack。
+// 为什么不用 @Provide/@Consume 传栈：冷启动首帧 Navigation 会重赋 @Provide 值，触发
+// "pathStack has changed during render"，继而导致首个 NavDestination 路由解析失败建空节点（页面空白）。
+// 单例让栈对象唯一稳定，根因规避（@Provide/@Consume 竞态）也最简单。
+export const MAIN_STACK: NavPathStack = new NavPathStack();
