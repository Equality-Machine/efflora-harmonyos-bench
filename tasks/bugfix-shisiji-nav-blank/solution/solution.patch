diff --git a/entry/src/main/ets/pages/ModuleHub.ets b/entry/src/main/ets/pages/ModuleHub.ets
new file mode 100644
index 0000000..e8d61db
--- /dev/null
+++ b/entry/src/main/ets/pages/ModuleHub.ets
@@ -0,0 +1,37 @@
+// 模块枢纽（branch-1 目的地）：四个模块的列表页统一从这里进入。
+// 首页只 push 'ModuleHub'（PageMap 第 1 分支，冷启动首个 push 唯一稳定），
+// 具体打开哪个模块由 moduleTarget 决定 → 在本组件内用普通 if 条件渲染（非 navDestination builder 分支），规避空节点 bug。
+import { moduleTarget } from '../common/NavBus';
+import { MAIN_STACK } from '../common/Router';
+import { DiningList } from './modules/DiningList';
+import { HotelList } from './modules/HotelList';
+import { PetList } from './modules/PetList';
+import { BookList } from './modules/BookList';
+
+@Component
+export struct ModuleHub {
+  @State route: string = 'dining';
+
+  aboutToAppear(): void {
+    this.route = moduleTarget;
+  }
+
+  build() {
+    NavDestination() {
+      if (this.route === 'HotelList') {
+        HotelList()
+      } else if (this.route === 'PetList') {
+        PetList()
+      } else if (this.route === 'BookList') {
+        BookList()
+      } else {
+        DiningList()
+      }
+    }
+    .hideTitleBar(true)
+    .onBackPressed(() => {
+      MAIN_STACK.pop();
+      return true;
+    })
+  }
+}
